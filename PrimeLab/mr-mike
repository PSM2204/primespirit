// ═══════════════════════════════════════
// GAME STATE
// ═══════════════════════════════════════
const STAGES = [
  {num:1, name:'FOCUS GATE',      desc:'Click ONLY the glowing portal. Wrong clicks break your combo!',  time:30},
  {num:2, name:'SHADOW CLONE',    desc:'One hero matches the target pose. Find them before time runs out!', time:25},
  {num:3, name:'MEMORY SLASH',    desc:'Watch the sequence of sword poses, then repeat them perfectly!',   time:0},
  {num:4, name:'EYE FOCUS',       desc:'Keep your cursor on the golden orb as it moves. Don\'t lose it!',  time:20},
  {num:5, name:'REACTION BATTLE', desc:'Incoming attacks! Jump, Dash, Duck, or Counter within milliseconds!', time:30},
  {num:6, name:'DISTRACTION STORM','desc':'Ignore everything — memes, alerts, coins. Click ONLY the mission target!', time:25},
  {num:7, name:'ULTRA INSTINCT',  desc:'Everything accelerates. Click the white orbs as fast as you can!', time:20},
  {num:8, name:'BOSS BATTLE',     desc:'Face the King of Distractions! Use memory, reaction, focus and precision!', time:0},
];

let gs = {};

function initState(){
  gs = {
    stage: 0,
    score: 0,
    combo: 0,
    maxCombo: 0,
    focusEnergy: 100,
    hits: 0,
    misses: 0,
    bestReaction: 9999,
    memoryCorrect: 0,
    memoryTotal: 0,
    timeLeft: 0,
    timerInterval: null,
    stageInterval: null,
    animFrame: null,
    rank: 'E',
    bossHP: 100,
    reactionStreak: 0,
    currentReaction: null,
    reactionStart: 0,
  };
}

const RANKS = ['E','D','C','B','A','S','SS','SSS','Legend','Mythic','Cosmic'];
function calcRank(score){
  if(score>15000) return 'Cosmic';
  if(score>10000) return 'Mythic';
  if(score>7000)  return 'Legend';
  if(score>5000)  return 'SSS';
  if(score>3500)  return 'SS';
  if(score>2500)  return 'S';
  if(score>1500)  return 'A';
  if(score>800)   return 'B';
  if(score>400)   return 'C';
  if(score>150)   return 'D';
  return 'E';
}

// ═══════════════════════════════════════
// UI HELPERS
// ═══════════════════════════════════════
function showScreen(id){
  document.querySelectorAll('.screen').forEach(s=>s.classList.remove('active'));
  document.getElementById(id).classList.add('active');
}

function showFeedback(text, cls){
  document.querySelectorAll('#feedback').forEach(el=>el.remove());
  const el = document.createElement('div');
  el.id='feedback'; el.className=cls; el.textContent=text;
  document.body.appendChild(el);
  el.addEventListener('animationend',()=>el.remove());
}

function spawnParticles(x,y,color='#00d4ff',count=12){
  const c=document.getElementById('particles-container');
  for(let i=0;i<count;i++){
    const p=document.createElement('div'); p.className='particle';
    const angle=Math.random()*Math.PI*2;
    const dist=40+Math.random()*80;
    p.style.cssText=`left:${x}px;top:${y}px;width:${3+Math.random()*5}px;height:${3+Math.random()*5}px;background:${color};--px:${Math.cos(angle)*dist}px;--py:${Math.sin(angle)*dist}px;animation-duration:${.4+Math.random()*.5}s`;
    c.appendChild(p);
    p.addEventListener('animationend',()=>p.remove());
  }
}

function updateHUD(){
  document.getElementById('hud-score').textContent = gs.score.toLocaleString();
  document.getElementById('hud-stage').textContent = `${gs.stage}/8`;
  document.getElementById('focus-bar').style.width = Math.max(0,gs.focusEnergy)+'%';
  document.getElementById('combo-num').textContent = gs.combo;
  gs.rank = calcRank(gs.score);
  document.getElementById('rank-badge').textContent = gs.rank;
}

function addScore(pts){
  const mult = 1 + gs.combo * 0.05;
  gs.score += Math.round(pts * mult);
  gs.hits++;
  gs.combo++;
  gs.maxCombo = Math.max(gs.maxCombo, gs.combo);
  gs.focusEnergy = Math.min(100, gs.focusEnergy + 3);
  updateHUD();
}

function missAction(){
  gs.misses++;
  gs.combo = 0;
  gs.focusEnergy = Math.max(0, gs.focusEnergy - 10);
  document.getElementById('game-screen').classList.add('shake');
  setTimeout(()=>document.getElementById('game-screen').classList.remove('shake'),400);
  showFeedback('MISS!','miss');
  updateHUD();
}

// Timer
let timerCtx;
function initTimerCanvas(){
  const canvas = document.getElementById('timer-canvas');
  timerCtx = canvas.getContext('2d');
}
function drawTimer(val, max){
  if(!timerCtx) return;
  const c = timerCtx, w=60, h=60, r=24;
  c.clearRect(0,0,w,h);
  c.beginPath(); c.arc(w/2,h/2,r,0,Math.PI*2);
  c.strokeStyle='rgba(255,255,255,0.05)'; c.lineWidth=5; c.stroke();
  if(max>0){
    const frac=val/max;
    c.beginPath(); c.arc(w/2,h/2,r,-Math.PI/2,-Math.PI/2+frac*Math.PI*2);
    c.strokeStyle = frac<.3?'#ff3333':frac<.6?'#ffd700':'#00d4ff';
    c.lineWidth=5; c.stroke();
  }
  document.getElementById('timer-val').textContent = Math.ceil(val);
}
function startTimer(secs, onDone){
  clearInterval(gs.timerInterval);
  gs.timeLeft = secs;
  drawTimer(secs, secs);
  if(secs<=0){onDone&&onDone();return;}
  const max=secs;
  gs.timerInterval=setInterval(()=>{
    gs.timeLeft-=.1;
    drawTimer(gs.timeLeft, max);
    if(gs.timeLeft<=0){ clearInterval(gs.timerInterval); onDone&&onDone(); }
  },100);
}

// ═══════════════════════════════════════
// STAGE INTRO
// ═══════════════════════════════════════
function showStageIntro(stageObj, cb){
  const si=document.getElementById('stage-intro');
  si.style.display='flex'; si.style.opacity='1';
  document.getElementById('si-num').textContent = `STAGE ${stageObj.num} OF 8`;
  document.getElementById('si-name').textContent = stageObj.name;
  document.getElementById('si-desc').textContent = stageObj.desc;
  let count=3;
  document.getElementById('stage-countdown').textContent=count;
  const t=setInterval(()=>{
    count--;
    if(count<=0){
      clearInterval(t);
      si.style.opacity='0';
      setTimeout(()=>{ si.style.display='none'; cb&&cb(); },500);
    } else {
      document.getElementById('stage-countdown').textContent=count;
    }
  },900);
}

// ═══════════════════════════════════════
// GAME FLOW
// ═══════════════════════════════════════
function startGame(){
  initState();
  showScreen('game-screen');
  initTimerCanvas();
  updateHUD();
  nextStage();
}
function nextStage(){
  // Hide all stages
  for(let i=1;i<=8;i++) document.getElementById(`stage${i}`).style.display='none';
  gs.stage++;
  if(gs.stage>8){ endGame(); return; }
  document.getElementById('hud-stage').textContent=`${gs.stage}/8`;
  const stageObj = STAGES[gs.stage-1];
  showStageIntro(stageObj, ()=>{ launchStage(gs.stage); });
}

function launchStage(n){
  const el=document.getElementById(`stage${n}`);
  el.style.display='block';
  switch(n){
    case 1: launchStage1(); break;
    case 2: launchStage2(); break;
    case 3: launchStage3(); break;
    case 4: launchStage4(); break;
    case 5: launchStage5(); break;
    case 6: launchStage6(); break;
    case 7: launchStage7(); break;
    case 8: launchStage8(); break;
  }
}

function stageComplete(){
  clearInterval(gs.timerInterval);
  clearInterval(gs.stageInterval);
  cancelAnimationFrame(gs.animFrame);
  showFeedback('STAGE CLEAR!','great');
  spawnParticles(window.innerWidth/2,window.innerHeight/2,'#00d4ff',20);
  addScore(500);
  setTimeout(nextStage, 1400);
}

// ═══════════════════════════════════════
// STAGE 1: FOCUS GATE
// ═══════════════════════════════════════
function launchStage1(){
  document.getElementById('instruction-bar').textContent='Click ONLY the glowing portal!';
  const area=document.getElementById('stage1');
  area.innerHTML='';
  let clicks=0;
  const goal=12;
  function spawnPortals(){
    area.innerHTML='';
    const count=3+Math.floor(clicks/3);
    const glowIdx=Math.floor(Math.random()*count);
    const symbols=['🌀','🌊','🔥','⚡','🌙','💫','🔮','✨','🌸','⭐'];
    const aw=area.clientWidth||window.innerWidth;
    const ah=area.clientHeight||(window.innerHeight-120);
    for(let i=0;i<count;i++){
      const p=document.createElement('div'); p.className='portal';
      const size=70+Math.random()*30;
      const x=Math.random()*(aw-size-20)+10;
      const y=Math.random()*(ah-size-20)+10;
      p.style.cssText=`width:${size}px;height:${size}px;left:${x}px;top:${y}px;font-size:${size*.4}px`;
      if(i===glowIdx){ p.classList.add('glow'); p.textContent='⚡'; }
      else { p.classList.add('fake'); p.textContent=symbols[Math.floor(Math.random()*symbols.length)]; }
      p.addEventListener('click', (e)=>{
        spawnParticles(e.clientX,e.clientY);
        if(i===glowIdx){
          addScore(100); clicks++;
          showFeedback(clicks%5===0?'INCREDIBLE!':'FOCUS!', 'great');
          if(clicks>=goal) stageComplete();
          else spawnPortals();
        } else {
          missAction();
          spawnPortals();
        }
      });
      area.appendChild(p);
    }
  }
  spawnPortals();
  startTimer(30, stageComplete);
}

// ═══════════════════════════════════════
// STAGE 2: SHADOW CLONE
// ═══════════════════════════════════════
const POSES = ['🗡','🛡','🏹','✊','🦵','👊','🤜','⚔','🥋','🔱'];
const CHARS = ['🥷','🧙','🗡','⚔','🏹','🛡','🔮','💪','🌊','⚡'];
function launchStage2(){
  document.getElementById('instruction-bar').textContent='Find the hero matching the TARGET POSE!';
  const area=document.getElementById('stage2');
  area.innerHTML='';
  let found=0, goal=8;
  function spawnClones(){
    area.innerHTML='';
    const targetPose=POSES[Math.floor(Math.random()*POSES.length)];
    // Target display
    const tgt=document.createElement('div');
    tgt.style.cssText=`position:absolute;top:12px;left:50%;transform:translateX(-50%);font-family:'Orbitron',sans-serif;font-size:12px;letter-spacing:3px;color:#889;text-align:center;`;
    tgt.innerHTML=`<span style="color:#aab;font-size:10px;">TARGET POSE</span><br><span style="font-size:52px;">${targetPose}</span>`;
    area.appendChild(tgt);
    const count=4+Math.floor(found/2);
    const correctIdx=Math.floor(Math.random()*count);
    const aw=area.clientWidth||window.innerWidth;
    const ah=(area.clientHeight||(window.innerHeight-120))-120;
    const cardW=90, cardH=100;
    for(let i=0;i<count;i++){
      const card=document.createElement('div'); card.className='clone-card';
      const col=count<=4?i:i%Math.ceil(count/2);
      const row=count<=4?0:Math.floor(i/Math.ceil(count/2));
      const cols=count<=4?count:Math.ceil(count/2);
      const totalW=cols*(cardW+14)-14;
      const startX=(aw-totalW)/2;
      card.style.cssText=`width:${cardW}px;height:${cardH}px;left:${startX+col*(cardW+14)}px;top:${120+row*(cardH+14)}px;`;
      const pose=i===correctIdx?targetPose:POSES.filter(p=>p!==targetPose)[Math.floor(Math.random()*(POSES.length-1))];
      const char=CHARS[Math.floor(Math.random()*CHARS.length)];
      card.innerHTML=`<div style="font-size:28px;">${char}</div><div style="font-size:22px;margin-top:4px;">${pose}</div>`;
      card.addEventListener('click',(e)=>{
        spawnParticles(e.clientX,e.clientY,i===correctIdx?'#00d4ff':'#ff3333');
        if(i===correctIdx){ addScore(120); found++; showFeedback('FOUND HIM!','great'); if(found>=goal)stageComplete(); else spawnClones(); }
        else { missAction(); spawnClones(); }
      });
      area.appendChild(card);
    }
  }
  spawnClones();
  startTimer(25, stageComplete);
}

// ═══════════════════════════════════════
// STAGE 3: MEMORY SLASH
// ═══════════════════════════════════════
const MEM_SYMBOLS=['⚔','🗡','🏹','🔮','💥','🌀','⚡','🔥','🌊','🛡'];
function launchStage3(){
  document.getElementById('instruction-bar').textContent='Watch carefully, then repeat!';
  document.getElementById('timer-val').textContent='—';
  drawTimer(0,0);
  let round=0, maxRounds=5;
  function doRound(){
    round++;
    const len=2+round;
    const seq=Array.from({length:len},()=>MEM_SYMBOLS[Math.floor(Math.random()*MEM_SYMBOLS.length)]);
    gs.memoryTotal++;
    const seqEl=document.getElementById('memory-sequence');
    const inputEl=document.getElementById('mem-input');
    const instrEl=document.getElementById('mem-instruction');
    instrEl.textContent='MEMORIZE THE SEQUENCE';
    seqEl.style.display='flex'; inputEl.style.display='none';
    seqEl.innerHTML='';
    seq.forEach((s,i)=>{
      const el=document.createElement('div'); el.className='mem-symbol';
      el.textContent='?'; seqEl.appendChild(el);
      setTimeout(()=>{
        el.textContent=s; el.classList.add('highlight');
        setTimeout(()=>{ el.textContent='?'; el.classList.remove('highlight'); },600);
      }, i*700);
    });
    // Wait for sequence display, then let player input
    setTimeout(()=>{
      instrEl.textContent='REPEAT THE SEQUENCE';
      seqEl.style.display='none'; inputEl.style.display='flex';
      inputEl.innerHTML='';
      MEM_SYMBOLS.slice(0,8).forEach(s=>{
        const btn=document.createElement('div'); btn.className='mem-symbol'; btn.textContent=s;
        let userSeq=[];
        btn.addEventListener('click',()=>{
          userSeq.push(s);
          btn.classList.add('highlight');
          setTimeout(()=>btn.classList.remove('highlight'),200);
          if(userSeq.length===seq.length){
            const correct=userSeq.every((v,i)=>v===seq[i]);
            if(correct){ gs.memoryCorrect++; addScore(150*round); showFeedback('PERFECT!','great'); spawnParticles(window.innerWidth/2,window.innerHeight/2,'#00d4ff'); }
            else { missAction(); showFeedback('WRONG!','miss'); }
            inputEl.querySelectorAll('.mem-symbol').forEach(b=>b.style.pointerEvents='none');
            if(round>=maxRounds) setTimeout(stageComplete,900);
            else setTimeout(doRound,1000);
          }
        });
        inputEl.appendChild(btn);
      });
      // Allow re-click tracking per sequence attempt
      let userSeqTrack=[];
      inputEl.querySelectorAll('.mem-symbol').forEach(btn=>{
        btn.addEventListener('click',function(){
          userSeqTrack.push(btn.textContent);
        });
      });
    }, seq.length*700+800);
  }
  doRound();
}

// ═══════════════════════════════════════
// STAGE 4: EYE FOCUS
// ═══════════════════════════════════════
function launchStage4(){
  document.getElementById('instruction-bar').textContent='Keep your cursor on the golden orb!';
  const area=document.getElementById('stage4');
  const target=document.getElementById('eye-target');
  const ring=document.getElementById('eye-cursor-ring');
  let tx=window.innerWidth/2, ty=window.innerHeight/2;
  let vx=3+Math.random()*2, vy=2+Math.random()*2;
  let tracking=false, trackScore=0;
  const aw=area.clientWidth||window.innerWidth;
  const ah=area.clientHeight||(window.innerHeight-120);
  area.addEventListener('mousemove',(e)=>{
    ring.style.left=e.clientX+'px'; ring.style.top=e.clientY+'px';
    const dx=e.clientX-tx, dy=e.clientY-(ty+60);
    tracking = Math.sqrt(dx*dx+dy*dy)<40;
  });
  area.addEventListener('touchmove',(e)=>{
    const t=e.touches[0];
    ring.style.left=t.clientX+'px'; ring.style.top=t.clientY+'px';
    const dx=t.clientX-tx, dy=t.clientY-(ty+60);
    tracking=Math.sqrt(dx*dx+dy*dy)<40;
  },{passive:true});
  function animate(){
    tx+=vx; ty+=vy;
    if(tx<20||tx>aw-20) vx*=-1;
    if(ty<80||ty>ah-20) vy*=-1;
    target.style.left=(tx-12)+'px'; target.style.top=(ty+48)+'px';
    if(tracking){ trackScore+=.5; gs.focusEnergy=Math.min(100,gs.focusEnergy+.05); }
    else { gs.focusEnergy=Math.max(0,gs.focusEnergy-.2); }
    if(trackScore>0&&Math.floor(trackScore)%30===0&&Math.floor(trackScore)>0){ addScore(50); }
    updateHUD();
    gs.animFrame=requestAnimationFrame(animate);
  }
  animate();
  startTimer(20,()=>{ cancelAnimationFrame(gs.animFrame); stageComplete(); });
}

// ═══════════════════════════════════════
// STAGE 5: REACTION BATTLE
// ═══════════════════════════════════════
const REACTIONS=['jump','dash','duck','counter'];
const REACTION_LABELS={jump:'⬆ JUMP!',dash:'▶ DASH!',duck:'⬇ DUCK!',counter:'⚔ COUNTER!'};
function launchStage5(){
  document.getElementById('instruction-bar').textContent='React to the incoming attack!';
  let count=0, goal=15;
  function nextReaction(){
    gs.currentReaction=REACTIONS[Math.floor(Math.random()*4)];
    const el=document.getElementById('reaction-prompt');
    el.textContent='...'; el.className='';
    const delay=600+Math.random()*1000;
    setTimeout(()=>{
      el.textContent=REACTION_LABELS[gs.currentReaction];
      el.className=gs.currentReaction;
      gs.reactionStart=Date.now();
    },delay);
  }
  nextReaction();
  startTimer(30,stageComplete);
  window._reactionCount=count; window._reactionGoal=goal;
}
function reactionHit(action){
  if(!gs.currentReaction) return;
  if(action===gs.currentReaction){
    const rt=Date.now()-gs.reactionStart;
    if(rt>2500){missAction();gs.currentReaction=null;nextReactionCall();return;}
    gs.bestReaction=Math.min(gs.bestReaction,rt);
    addScore(rt<250?250:rt<400?180:120);
    gs.reactionStreak++;
    document.getElementById('reaction-streak').textContent='STREAK: '+gs.reactionStreak;
    showFeedback(rt<250?'LIGHTNING!':'SHARP!','great');
    spawnParticles(window.innerWidth/2,window.innerHeight/2,'#00ff88',10);
    gs.currentReaction=null;
    let c=(window._reactionCount||0)+1; window._reactionCount=c;
    if(c>=(window._reactionGoal||15)) stageComplete();
    else nextReactionCall();
  } else {
    missAction(); gs.reactionStreak=0;
    document.getElementById('reaction-streak').textContent='STREAK: 0';
    gs.currentReaction=null;
    nextReactionCall();
  }
}
function nextReactionCall(){
  const el=document.getElementById('reaction-prompt');
  el.textContent='...'; el.className='';
  const delay=600+Math.random()*800;
  setTimeout(()=>{
    gs.currentReaction=REACTIONS[Math.floor(Math.random()*4)];
    el.textContent=REACTION_LABELS[gs.currentReaction]; el.className=gs.currentReaction;
    gs.reactionStart=Date.now();
  },delay);
}

// ═══════════════════════════════════════
// STAGE 6: DISTRACTION STORM
// ═══════════════════════════════════════
const DISTRACTIONS=['📱','💬','🔔','💰','🎮','📺','🍕','😂','🎵','💌','🎁','🌮','🛒','📸','🎉'];
function launchStage6(){
  document.getElementById('instruction-bar').textContent='Click ONLY the mission target 🎯 — ignore everything else!';
  const area=document.getElementById('stage6');
  let clicks=0, goal=10;
  document.getElementById('mission-target-s6').onclick=(e)=>{
    spawnParticles(e.clientX,e.clientY,'#00d4ff',15);
    addScore(200); clicks++;
    showFeedback('FOCUSED!','great');
    if(clicks>=goal) stageComplete();
  };
  function spawnDistraction(){
    const d=document.createElement('div'); d.className='distraction';
    d.textContent=DISTRACTIONS[Math.floor(Math.random()*DISTRACTIONS.length)];
    d.style.left=Math.random()*90+'%';
    d.style.bottom='-10%';
    const dur=2+Math.random()*3;
    d.style.animationDuration=dur+'s';
    d.style.animationDelay=Math.random()*.5+'s';
    d.addEventListener('click',(e)=>{ missAction(); spawnParticles(e.clientX,e.clientY,'#ff3333',6); });
    area.appendChild(d);
    setTimeout(()=>d.remove(),dur*1000+500);
  }
  gs.stageInterval=setInterval(spawnDistraction,400);
  startTimer(25,()=>{ clearInterval(gs.stageInterval); stageComplete(); });
}

// ═══════════════════════════════════════
// STAGE 7: ULTRA INSTINCT
// ═══════════════════════════════════════
function launchStage7(){
  document.getElementById('instruction-bar').textContent='Click the white orbs — ultra speed mode!';
  const area=document.getElementById('stage7');
  let clicks=0, goal=20;
  function spawnOrb(){
    const t=document.getElementById('ui-click-target');
    const aw=area.clientWidth||window.innerWidth;
    const ah=(area.clientHeight||(window.innerHeight-120));
    const size=25+Math.random()*35;
    const x=size/2+Math.random()*(aw-size);
    const y=size/2+80+Math.random()*(ah-size-80);
    t.style.width=size+'px'; t.style.height=size+'px';
    t.style.left=x+'px'; t.style.top=y+'px';
    t.onclick=(e)=>{
      spawnParticles(e.clientX,e.clientY,'#ffffff',12);
      addScore(150); clicks++;
      showFeedback('INSTINCT!','great');
      if(clicks>=goal) stageComplete();
      else spawnOrb();
    };
  }
  spawnOrb();
  // Spawn extra orbs as distractors
  const orbColors=['rgba(0,212,255,0.15)','rgba(191,0,255,0.15)','rgba(255,215,0,0.1)'];
  for(let i=0;i<8;i++){
    const orb=document.createElement('div'); orb.className='ui-orb';
    const size=15+Math.random()*25;
    const aw=area.clientWidth||window.innerWidth;
    const ah=area.clientHeight||(window.innerHeight-120);
    orb.style.cssText=`width:${size}px;height:${size}px;left:${Math.random()*aw}px;top:${80+Math.random()*(ah-80)}px;background:${orbColors[i%3]};border:1px solid rgba(255,255,255,0.1);--tx:${(Math.random()-.5)*200}px;--ty:${(Math.random()-.5)*200}px;animation-duration:${2+Math.random()*3}s;animation-direction:alternate;animation-iteration-count:infinite`;
    area.appendChild(orb);
  }
  startTimer(20,stageComplete);
}

// ═══════════════════════════════════════
// STAGE 8: BOSS BATTLE
// ═══════════════════════════════════════
const BOSS_ATTACKS=[
  {text:'MEMORY STRIKE! Use RECALL!', correct:'memory'},
  {text:'COUNTER INCOMING! Press COUNTER!', correct:'react'},
  {text:'FOCUS BEAM! Use FOCUS!', correct:'focus'},
  {text:'PRECISION SLASH! Use PRECISION!', correct:'precision'},
];
let bossPhase=0;
function launchStage8(){
  document.getElementById('instruction-bar').textContent='Defeat the King of Distractions!';
  gs.bossHP=100;
  bossPhase=0;
  nextBossAttack();
}
function nextBossAttack(){
  if(gs.bossHP<=0){stageComplete();return;}
  const atk=BOSS_ATTACKS[Math.floor(Math.random()*BOSS_ATTACKS.length)];
  document.getElementById('boss-attack').textContent=atk.text;
  document.getElementById('boss-attack').dataset.correct=atk.correct;
}
function bossAction(action){
  const correct=document.getElementById('boss-attack').dataset.correct;
  if(action===correct){
    gs.bossHP-=25;
    document.getElementById('boss-hp-fill').style.width=Math.max(0,gs.bossHP)+'%';
    addScore(300);
    spawnParticles(window.innerWidth/2,window.innerHeight/3,'#00d4ff',20);
    showFeedback('CRITICAL HIT!','great');
    if(gs.bossHP<=0){
      document.getElementById('boss-attack').textContent='YOU WIN! 🏆';
      setTimeout(stageComplete,1000);
    } else {
      setTimeout(nextBossAttack,800);
    }
  } else {
    missAction();
    showFeedback('BLOCKED!','miss');
    gs.focusEnergy-=10; updateHUD();
    setTimeout(nextBossAttack,600);
  }
}

// ═══════════════════════════════════════
// END GAME
// ═══════════════════════════════════════
function endGame(){
  const rank=calcRank(gs.score);
  const acc=gs.hits+gs.misses>0?Math.round(gs.hits/(gs.hits+gs.misses)*100):0;
  const react=gs.bestReaction===9999?'—':gs.bestReaction;
  const memPct=gs.memoryTotal>0?Math.round(gs.memoryCorrect/gs.memoryTotal*100):100;
  // Save high score
  const prev=parseInt(localStorage.getItem('mrmike_best')||'0');
  if(gs.score>prev) localStorage.setItem('mrmike_best',gs.score);
  // Populate results
  document.getElementById('res-rank').textContent=rank;
  document.getElementById('res-score').textContent=gs.score.toLocaleString();
  document.getElementById('res-acc').textContent=acc+'%';
  document.getElementById('res-react').textContent=(react==='—'?'—':react+'ms');
  document.getElementById('res-combo').textContent=gs.maxCombo;
  document.getElementById('res-xp').textContent='+'+(Math.round(gs.score/10));
  document.getElementById('res-mem').textContent=memPct+'%';
  // Share box
  document.getElementById('sb-rank').textContent=rank;
  document.getElementById('sb-react').textContent=react==='—'?'—':react;
  document.getElementById('sb-acc').textContent=acc;
  document.getElementById('sb-combo').textContent=gs.maxCombo;
  showScreen('results-screen');
  // Update title
  const best=localStorage.getItem('mrmike_best')||0;
  document.getElementById('title-best').textContent=parseInt(best).toLocaleString();
  document.getElementById('title-rank').textContent=calcRank(parseInt(best));
}

function restartGame(){
  clearInterval(gs.timerInterval);
  clearInterval(gs.stageInterval);
  cancelAnimationFrame(gs.animFrame);
  startGame();
}
function showTitle(){
  clearInterval(gs.timerInterval);
  clearInterval(gs.stageInterval);
  cancelAnimationFrame(gs.animFrame);
  const best=localStorage.getItem('mrmike_best')||0;
  document.getElementById('title-best').textContent=parseInt(best).toLocaleString();
  document.getElementById('title-rank').textContent=calcRank(parseInt(best));
  showScreen('title-screen');
}
function copyShare(){
  const rank=document.getElementById('sb-rank').textContent;
  const react=document.getElementById('sb-react').textContent;
  const acc=document.getElementById('sb-acc').textContent;
  const combo=document.getElementById('sb-combo').textContent;
  const score=document.getElementById('res-score').textContent;
  const text=`🧠 Focus Rank: ${rank}\n⚡ Reaction: ${react}ms | 🎯 Accuracy: ${acc}%\n🔥 Max Combo: ${combo} | Score: ${score}\n"I conquered the Mind Realm in Mr. Mike!"\nPlay at PrimeLab — primespirit.co.in`;
  navigator.clipboard.writeText(text).then(()=>showFeedback('COPIED!','great')).catch(()=>showFeedback('COPY FAILED','miss'));
}

// Init
(function(){
  const best=localStorage.getItem('mrmike_best')||0;
  if(parseInt(best)>0){
    document.getElementById('title-best').textContent=parseInt(best).toLocaleString();
    document.getElementById('title-rank').textContent=calcRank(parseInt(best));
  }
})();
</script>
