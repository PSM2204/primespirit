<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Mr. Mike: Focus Dimension | PrimeLab</title>
<style>
  @import url('https://fonts.googleapis.com/css2?family=Orbitron:wght@400;700;900&family=Exo+2:wght@300;400;600;700&display=swap');

  :root {
    --neon-blue: #00d4ff;
    --neon-purple: #bf00ff;
    --neon-gold: #ffd700;
    --neon-red: #ff3333;
    --neon-green: #00ff88;
    --bg-dark: #04040f;
    --bg-panel: rgba(10,10,30,0.92);
    --text-main: #e8eaff;
  }

  * { margin:0; padding:0; box-sizing:border-box; }

  body {
    background: var(--bg-dark);
    font-family: 'Exo 2', sans-serif;
    color: var(--text-main);
    overflow: hidden;
    height: 100vh;
    width: 100vw;
  }

  /* ─── STARFIELD ─── */
  #starfield {
    position: fixed; inset:0; z-index:0;
    background: radial-gradient(ellipse at 20% 50%, #0d0025 0%, #04040f 60%);
  }
  .star { position:absolute; border-radius:50%; animation: twinkle linear infinite; }
  @keyframes twinkle { 0%,100%{opacity:.2} 50%{opacity:1} }

  /* ─── SCREENS ─── */
  .screen { position:fixed; inset:0; z-index:10; display:none; flex-direction:column; align-items:center; justify-content:center; }
  .screen.active { display:flex; }

  /* ─── TITLE SCREEN ─── */
  #title-screen {
    background: linear-gradient(160deg, rgba(0,0,20,0.95) 0%, rgba(30,0,60,0.9) 100%);
  }

  .primelab-badge {
    position:absolute; top:18px; left:50%; transform:translateX(-50%);
    font-family:'Orbitron',sans-serif; font-size:11px; letter-spacing:4px; color:#888;
    text-transform:uppercase;
  }
  .primelab-badge span { color: var(--neon-blue); }

  /* ─── ANIME CHARACTER ─── */
  .anime-character {
    position:relative; width:220px; height:280px; margin-bottom:10px;
    animation: charFloat 3s ease-in-out infinite;
  }
  @keyframes charFloat { 0%,100%{transform:translateY(0)} 50%{transform:translateY(-12px)} }

  .char-aura {
    position:absolute; inset:-30px; border-radius:50%;
    background: radial-gradient(ellipse, rgba(0,212,255,0.3) 0%, transparent 70%);
    animation: auraPulse 2s ease-in-out infinite;
  }
  @keyframes auraPulse { 0%,100%{transform:scale(1);opacity:.7} 50%{transform:scale(1.15);opacity:1} }

  /* SVG Anime Character */
  .char-svg { width:100%; height:100%; filter: drop-shadow(0 0 18px #00d4ff) drop-shadow(0 0 40px #bf00ff); }

  .title-logo {
    font-family:'Orbitron',sans-serif;
    font-size:clamp(28px,5vw,52px);
    font-weight:900;
    text-align:center;
    line-height:1;
    background: linear-gradient(135deg, #00d4ff 0%, #bf00ff 50%, #ffd700 100%);
    -webkit-background-clip:text; -webkit-text-fill-color:transparent;
    filter: drop-shadow(0 0 20px rgba(0,212,255,0.5));
    margin-bottom:6px;
  }
  .title-sub {
    font-family:'Orbitron',sans-serif; font-size:12px; letter-spacing:5px;
    color:#bf00ff; text-transform:uppercase; margin-bottom:8px;
  }
  .title-tagline {
    font-size:13px; color:#aab; text-align:center; max-width:320px;
    margin-bottom:28px; font-style:italic; line-height:1.5;
  }

  .btn-primary {
    font-family:'Orbitron',sans-serif; font-size:14px; font-weight:700;
    letter-spacing:3px; text-transform:uppercase;
    padding:14px 40px; border:none; border-radius:4px; cursor:pointer;
    background: linear-gradient(135deg, #00d4ff, #bf00ff);
    color:#fff; position:relative; overflow:hidden;
    box-shadow: 0 0 30px rgba(0,212,255,0.4), 0 0 60px rgba(191,0,255,0.2);
    transition: all .2s;
  }
  .btn-primary:hover { transform:scale(1.05); box-shadow: 0 0 50px rgba(0,212,255,0.7); }
  .btn-primary::before {
    content:''; position:absolute; top:-50%; left:-60%; width:40%; height:200%;
    background: rgba(255,255,255,0.15); transform:skewX(-20deg);
    animation: btnShine 3s ease-in-out infinite;
  }
  @keyframes btnShine { 0%,100%{left:-60%} 40%,60%{left:120%} }

  .high-score-display {
    margin-top:16px; font-size:11px; letter-spacing:2px; color:#666; text-align:center;
  }
  .high-score-display span { color: var(--neon-gold); font-weight:700; }

  /* ─── GAME SCREEN ─── */
  #game-screen { background: var(--bg-dark); flex-direction:column; }

  /* HUD */
  #hud {
    position:fixed; top:0; left:0; right:0; z-index:50;
    display:flex; align-items:center; gap:12px; padding:10px 16px;
    background: rgba(4,4,15,0.95); border-bottom:1px solid rgba(0,212,255,0.2);
  }
  .hud-section { display:flex; flex-direction:column; }
  .hud-label { font-size:8px; letter-spacing:2px; color:#555; text-transform:uppercase; }
  .hud-value { font-family:'Orbitron',sans-serif; font-size:14px; font-weight:700; color:var(--neon-blue); }
  .hud-sep { width:1px; height:36px; background:rgba(255,255,255,0.1); }
  #focus-bar-wrap { flex:1; }
  .focus-bar-bg { height:8px; border-radius:4px; background:rgba(255,255,255,0.05); overflow:hidden; margin-top:4px; }
  .focus-bar-fill {
    height:100%; border-radius:4px;
    background: linear-gradient(90deg, var(--neon-blue), var(--neon-purple));
    transition: width .3s ease;
    box-shadow: 0 0 8px var(--neon-blue);
  }
  #rank-badge {
    font-family:'Orbitron',sans-serif; font-size:20px; font-weight:900;
    background: linear-gradient(135deg, var(--neon-gold), #ff8800);
    -webkit-background-clip:text; -webkit-text-fill-color:transparent;
    min-width:32px; text-align:center;
  }

  /* GAME CANVAS AREA */
  #game-area {
    position:fixed; top:60px; left:0; right:0; bottom:0;
    display:flex; flex-direction:column; align-items:center; justify-content:center;
  }

  /* Stage title overlay */
  #stage-intro {
    position:fixed; inset:0; z-index:80;
    display:flex; flex-direction:column; align-items:center; justify-content:center;
    background: rgba(4,4,15,0.95);
    transition: opacity .5s;
  }
  .stage-num {
    font-family:'Orbitron',sans-serif; font-size:11px; letter-spacing:6px; color:#555;
    text-transform:uppercase; margin-bottom:8px;
  }
  .stage-name {
    font-family:'Orbitron',sans-serif; font-size:clamp(26px,5vw,56px); font-weight:900;
    background: linear-gradient(135deg, var(--neon-blue), var(--neon-purple));
    -webkit-background-clip:text; -webkit-text-fill-color:transparent;
    margin-bottom:12px;
  }
  .stage-desc { font-size:14px; color:#889; max-width:340px; text-align:center; line-height:1.6; }
  #stage-countdown {
    margin-top:30px; font-family:'Orbitron',sans-serif; font-size:64px; font-weight:900;
    color:var(--neon-blue); filter:drop-shadow(0 0 20px var(--neon-blue));
    animation: countPulse .9s ease-in-out infinite;
  }
  @keyframes countPulse { 0%,100%{transform:scale(1)} 50%{transform:scale(1.15)} }

  /* ─── STAGE 1: Focus Gate ─── */
  #stage1 { width:100%; height:100%; position:relative; }
  .portal {
    position:absolute; border-radius:50%; cursor:pointer;
    display:flex; align-items:center; justify-content:center;
    font-size:28px; transition: transform .15s;
    border:3px solid rgba(255,255,255,0.1);
  }
  .portal:hover { transform:scale(1.1); }
  .portal.glow {
    background: radial-gradient(circle, rgba(0,212,255,0.6), rgba(0,212,255,0.1));
    border-color: var(--neon-blue);
    box-shadow: 0 0 20px var(--neon-blue), 0 0 40px rgba(0,212,255,0.3);
    animation: portalPulse 1.2s ease-in-out infinite;
  }
  .portal.fake {
    background: radial-gradient(circle, rgba(100,100,150,0.3), rgba(50,50,80,0.1));
    border-color: rgba(100,100,150,0.3);
  }
  @keyframes portalPulse { 0%,100%{box-shadow:0 0 20px var(--neon-blue)} 50%{box-shadow:0 0 40px var(--neon-blue),0 0 80px rgba(0,212,255,0.5)} }

  /* ─── STAGE 2: Shadow Clone ─── */
  #stage2 { width:100%; height:100%; position:relative; }
  .clone-card {
    position:absolute; cursor:pointer; border-radius:8px;
    background: rgba(10,10,30,0.9); border:2px solid rgba(0,212,255,0.1);
    display:flex; flex-direction:column; align-items:center; justify-content:center;
    padding:10px; transition: all .15s;
  }
  .clone-card:hover { border-color: rgba(0,212,255,0.5); transform:scale(1.05); }
  .clone-card.correct-clone { border-color: var(--neon-blue); box-shadow:0 0 20px rgba(0,212,255,0.4); }

  /* ─── STAGE 3: Memory Slash ─── */
  #stage3 { width:100%; height:100%; display:flex; flex-direction:column; align-items:center; justify-content:center; gap:20px; }
  #memory-sequence { display:flex; gap:12px; flex-wrap:wrap; justify-content:center; }
  .mem-symbol {
    width:64px; height:64px; border-radius:8px;
    background: rgba(10,10,30,0.9); border:2px solid rgba(0,212,255,0.2);
    display:flex; align-items:center; justify-content:center; font-size:28px;
    cursor:pointer; transition:all .15s; user-select:none;
  }
  .mem-symbol:hover { border-color:var(--neon-blue); transform:scale(1.05); }
  .mem-symbol.highlight {
    background: rgba(0,212,255,0.2); border-color:var(--neon-blue);
    box-shadow: 0 0 20px rgba(0,212,255,0.5);
  }
  .mem-symbol.wrong { background:rgba(255,50,50,0.3); border-color:var(--neon-red); }
  #mem-instruction { font-family:'Orbitron',sans-serif; font-size:13px; letter-spacing:2px; color:#889; }

  /* ─── STAGE 4: Eye Focus ─── */
  #stage4 { width:100%; height:100%; position:relative; }
  #eye-target {
    position:absolute; width:24px; height:24px; border-radius:50%;
    background: radial-gradient(circle, #ffd700, #ff8800);
    box-shadow: 0 0 20px #ffd700, 0 0 40px rgba(255,215,0,0.5);
    pointer-events:none; transition: left .08s linear, top .08s linear;
  }
  #eye-cursor-ring {
    position:absolute; width:40px; height:40px; border-radius:50%;
    border:2px solid rgba(0,212,255,0.6); pointer-events:none;
    transform:translate(-50%,-50%);
    box-shadow: 0 0 10px rgba(0,212,255,0.4);
  }

  /* ─── STAGE 5: Reaction Battle ─── */
  #stage5 { width:100%; height:100%; display:flex; flex-direction:column; align-items:center; justify-content:center; gap:20px; }
  #reaction-prompt {
    font-family:'Orbitron',sans-serif; font-size:clamp(32px,6vw,72px); font-weight:900;
    text-align:center; transition:all .2s;
  }
  #reaction-prompt.jump { color:var(--neon-green); filter:drop-shadow(0 0 20px var(--neon-green)); }
  #reaction-prompt.dash { color:var(--neon-blue); filter:drop-shadow(0 0 20px var(--neon-blue)); }
  #reaction-prompt.duck { color:var(--neon-gold); filter:drop-shadow(0 0 20px var(--neon-gold)); }
  #reaction-prompt.counter { color:var(--neon-purple); filter:drop-shadow(0 0 20px var(--neon-purple)); }
  .reaction-btns { display:flex; gap:12px; flex-wrap:wrap; justify-content:center; }
  .react-btn {
    padding:12px 24px; border-radius:6px; border:2px solid;
    font-family:'Orbitron',sans-serif; font-size:12px; font-weight:700;
    letter-spacing:2px; cursor:pointer; background:rgba(10,10,30,0.9);
    transition:all .15s; text-transform:uppercase;
  }
  .react-btn.jump { border-color:var(--neon-green); color:var(--neon-green); }
  .react-btn.dash { border-color:var(--neon-blue); color:var(--neon-blue); }
  .react-btn.duck { border-color:var(--neon-gold); color:var(--neon-gold); }
  .react-btn.counter { border-color:var(--neon-purple); color:var(--neon-purple); }
  .react-btn:hover { transform:scale(1.08); filter:brightness(1.3); }

  /* ─── STAGE 6: Distraction Storm ─── */
  #stage6 { width:100%; height:100%; position:relative; overflow:hidden; }
  .distraction {
    position:absolute; cursor:pointer; user-select:none;
    font-size:clamp(16px,3vw,28px); animation: floatAround linear infinite;
    pointer-events:auto;
  }
  @keyframes floatAround {
    0% { transform:translateY(0) rotate(0deg); opacity:1; }
    100% { transform:translateY(-120vh) rotate(360deg); opacity:0; }
  }
  #mission-target-s6 {
    position:absolute; top:50%; left:50%; transform:translate(-50%,-50%);
    width:90px; height:90px; border-radius:50%;
    background: radial-gradient(circle, rgba(0,212,255,0.5), rgba(0,212,255,0.1));
    border:3px solid var(--neon-blue); box-shadow:0 0 30px var(--neon-blue);
    display:flex; align-items:center; justify-content:center;
    font-size:36px; cursor:pointer;
    animation: missionPulse 1s ease-in-out infinite;
  }
  @keyframes missionPulse { 0%,100%{box-shadow:0 0 20px var(--neon-blue)} 50%{box-shadow:0 0 50px var(--neon-blue)} }

  /* ─── STAGE 7: Ultra Instinct ─── */
  #stage7 { width:100%; height:100%; position:relative; overflow:hidden; }
  #ui-bg { position:absolute; inset:0; background: linear-gradient(45deg, #000008, #0a0025, #150030); animation: uiBgShift 2s linear infinite; }
  @keyframes uiBgShift { 0%{filter:hue-rotate(0)} 100%{filter:hue-rotate(360deg)} }
  .ui-orb {
    position:absolute; border-radius:50%; pointer-events:none;
    animation: orbMove linear infinite;
  }
  @keyframes orbMove { 0%{transform:translate(0,0)} 100%{transform:translate(var(--tx),var(--ty))} }
  #ui-click-target {
    position:absolute; border-radius:50%; cursor:pointer;
    background: radial-gradient(circle, rgba(255,255,255,0.9), rgba(0,212,255,0.5));
    box-shadow: 0 0 30px #fff, 0 0 60px var(--neon-blue);
    transform:translate(-50%,-50%);
    transition: width .1s, height .1s;
  }

  /* ─── STAGE 8: Boss Battle ─── */
  #stage8 { width:100%; height:100%; display:flex; flex-direction:column; align-items:center; justify-content:center; gap:16px; position:relative; overflow:hidden; }
  #boss-character {
    font-size:80px; animation: bossFloat 2s ease-in-out infinite;
    filter:drop-shadow(0 0 30px var(--neon-red));
  }
  @keyframes bossFloat { 0%,100%{transform:translateY(0) scale(1)} 50%{transform:translateY(-10px) scale(1.05)} }
  #boss-hp-bar { width:min(400px,90vw); }
  #boss-hp-fill {
    height:14px; border-radius:7px;
    background: linear-gradient(90deg, #ff3333, #ff8800);
    box-shadow: 0 0 10px #ff3333; transition: width .3s;
  }
  #boss-attack {
    font-family:'Orbitron',sans-serif; font-size:clamp(20px,4vw,40px); font-weight:900;
    color:var(--neon-red); filter:drop-shadow(0 0 15px var(--neon-red));
    animation: attackFlash .5s ease-in-out;
  }
  @keyframes attackFlash { 0%{transform:scale(.8);opacity:0} 50%{transform:scale(1.2)} 100%{transform:scale(1);opacity:1} }
  .boss-btns { display:flex; gap:10px; flex-wrap:wrap; justify-content:center; }
  .boss-btn {
    padding:12px 22px; border-radius:6px; border:2px solid var(--neon-red);
    font-family:'Orbitron',sans-serif; font-size:11px; font-weight:700;
    letter-spacing:2px; cursor:pointer; background:rgba(30,5,5,0.9);
    color:var(--neon-red); transition:all .15s; text-transform:uppercase;
  }
  .boss-btn:hover { background:rgba(255,50,50,0.2); transform:scale(1.05); }

  /* ─── FEEDBACK OVERLAY ─── */
  #feedback {
    position:fixed; z-index:100;
    font-family:'Orbitron',sans-serif; font-size:clamp(22px,5vw,52px); font-weight:900;
    pointer-events:none; top:50%; left:50%; transform:translate(-50%,-50%);
    animation: feedbackPop .7s forwards;
  }
  #feedback.good { color:var(--neon-blue); filter:drop-shadow(0 0 20px var(--neon-blue)); }
  #feedback.great { color:var(--neon-green); filter:drop-shadow(0 0 20px var(--neon-green)); }
  #feedback.miss { color:var(--neon-red); filter:drop-shadow(0 0 20px var(--neon-red)); }
  @keyframes feedbackPop {
    0%{opacity:0;transform:translate(-50%,-80%) scale(.6)}
    30%{opacity:1;transform:translate(-50%,-50%) scale(1.2)}
    70%{opacity:1;transform:translate(-50%,-50%) scale(1)}
    100%{opacity:0;transform:translate(-50%,-30%) scale(.9)}
  }

  /* SHAKE */
  @keyframes shake {
    0%,100%{transform:translateX(0)} 20%{transform:translateX(-8px)} 40%{transform:translateX(8px)} 60%{transform:translateX(-6px)} 80%{transform:translateX(6px)}
  }
  .shake { animation: shake .4s ease-in-out; }

  /* COMBO */
  #combo-display {
    position:fixed; top:70px; right:16px; z-index:50;
    font-family:'Orbitron',sans-serif; font-size:11px; letter-spacing:2px; text-align:right;
  }
  #combo-num { font-size:32px; font-weight:900; color:var(--neon-gold); line-height:1; }

  /* TIMER ARC */
  #timer-wrap {
    position:fixed; bottom:16px; left:50%; transform:translateX(-50%); z-index:50;
    display:flex; flex-direction:column; align-items:center; gap:4px;
  }
  #timer-canvas { filter:drop-shadow(0 0 8px var(--neon-blue)); }
  #timer-val { font-family:'Orbitron',sans-serif; font-size:14px; color:var(--neon-blue); }

  /* ─── RESULTS SCREEN ─── */
  #results-screen {
    background: linear-gradient(160deg, rgba(0,0,20,0.97) 0%, rgba(20,0,40,0.95) 100%);
    padding:20px; overflow-y:auto;
  }
  .results-title {
    font-family:'Orbitron',sans-serif; font-size:clamp(20px,4vw,38px); font-weight:900;
    background: linear-gradient(135deg, var(--neon-blue), var(--neon-purple), var(--neon-gold));
    -webkit-background-clip:text; -webkit-text-fill-color:transparent;
    margin-bottom:8px; text-align:center;
  }
  .final-rank {
    font-family:'Orbitron',sans-serif; font-size:clamp(48px,10vw,96px); font-weight:900;
    background: linear-gradient(135deg, var(--neon-gold), #ff8800);
    -webkit-background-clip:text; -webkit-text-fill-color:transparent;
    filter:drop-shadow(0 0 20px rgba(255,215,0,0.5));
    text-align:center; line-height:1;
  }
  .stats-grid {
    display:grid; grid-template-columns:1fr 1fr; gap:10px;
    width:min(420px,92vw); margin:16px auto;
  }
  .stat-card {
    background: rgba(10,10,30,0.9); border:1px solid rgba(0,212,255,0.15);
    border-radius:8px; padding:12px;
  }
  .stat-label { font-size:9px; letter-spacing:2px; color:#555; text-transform:uppercase; margin-bottom:4px; }
  .stat-val { font-family:'Orbitron',sans-serif; font-size:20px; font-weight:700; color:var(--neon-blue); }
  .stat-val.gold { color:var(--neon-gold); }
  .stat-val.green { color:var(--neon-green); }

  .share-box {
    background: rgba(0,212,255,0.05); border:1px solid rgba(0,212,255,0.2);
    border-radius:8px; padding:16px; margin:12px auto; width:min(420px,92vw);
    text-align:center; font-size:13px; line-height:1.8; color:#aab;
  }
  .share-box strong { color:var(--neon-blue); font-family:'Orbitron',sans-serif; }

  .btn-row { display:flex; gap:10px; justify-content:center; flex-wrap:wrap; margin-top:14px; }
  .btn-sec {
    padding:10px 22px; border-radius:4px; border:2px solid rgba(0,212,255,0.4);
    font-family:'Orbitron',sans-serif; font-size:11px; font-weight:700; letter-spacing:2px;
    cursor:pointer; background:rgba(0,212,255,0.05); color:var(--neon-blue);
    transition:all .2s; text-transform:uppercase;
  }
  .btn-sec:hover { background:rgba(0,212,255,0.15); border-color:var(--neon-blue); }

  /* SPEED LINES */
  #speed-lines { position:fixed; inset:0; z-index:5; pointer-events:none; opacity:0; transition:opacity .3s; }
  #speed-lines canvas { width:100%; height:100%; }

  /* PARTICLES */
  #particles-container { position:fixed; inset:0; z-index:6; pointer-events:none; }
  .particle {
    position:absolute; border-radius:50%; pointer-events:none;
    animation: particleFly linear forwards;
  }
  @keyframes particleFly {
    0%{opacity:1;transform:translate(0,0) scale(1)}
    100%{opacity:0;transform:translate(var(--px),var(--py)) scale(0)}
  }

  /* INSTRUCTION BAR */
  #instruction-bar {
    position:fixed; bottom:60px; left:50%; transform:translateX(-50%); z-index:50;
    background:rgba(0,0,0,0.7); border:1px solid rgba(0,212,255,0.2); border-radius:20px;
    padding:8px 20px; font-size:12px; letter-spacing:1px; color:#889;
    white-space:nowrap; pointer-events:none;
    backdrop-filter:blur(8px);
  }

  /* Character mini portrait */
  .char-mini {
    width:40px; height:40px; border-radius:50%; overflow:hidden;
    border:2px solid var(--neon-blue); box-shadow:0 0 10px rgba(0,212,255,0.4);
  }
</style>
</head>
<body>

<!-- Starfield -->
<div id="starfield"></div>
<div id="speed-lines"><canvas id="sl-canvas"></canvas></div>
<div id="particles-container" id="particles"></div>

<!-- TITLE SCREEN -->
<div class="screen active" id="title-screen">
  <div class="primelab-badge">Prime<span>Lab</span> — primespirit.co.in</div>

  <div class="anime-character">
    <div class="char-aura"></div>
    <svg class="char-svg" viewBox="0 0 220 280" fill="none" xmlns="http://www.w3.org/2000/svg">
      <!-- Aura glow rings -->
